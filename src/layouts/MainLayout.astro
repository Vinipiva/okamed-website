---
import "../styles/global.css";
import { useTranslations } from "../i18n/utils";

const locale = Astro.currentLocale ?? 'pt';
const t = useTranslations(locale);

const {
  title = "Okamed — Engenharia Clínica",
  description = t.locale === 'es'
    ? "Ingeniería clínica con tecnología propia para gestión, mantenimiento y trazabilidad de equipos médicos."
    : "Engenharia clínica com tecnologia própria para gestão, manutenção e rastreabilidade de equipamentos médicos.",
} = Astro.props;
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <link rel="alternate" hreflang="pt-br" href="https://okamed.com.br/" />
    <link rel="alternate" hreflang="es" href="https://okamed.com.br/es/" />
    <link rel="alternate" hreflang="x-default" href="https://okamed.com.br/" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
  </head>

  <body class="min-h-screen bg-[#F4F6F8]">
    <div class="noise-overlay" aria-hidden="true"></div>
    <div class="ambient-layer" aria-hidden="true">
      <div class="amb-orb amb-orb-1" id="ambOrb1"></div>
      <div class="amb-orb amb-orb-2" id="ambOrb2"></div>
      <div class="amb-orb amb-orb-3" id="ambOrb3"></div>
      <div class="amb-orb amb-orb-4" id="ambOrb4"></div>
    </div>
    <slot />
  </body>
</html>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add("visible");
          observer.unobserve(e.target);
        }
      });
    },
    { threshold: 0.1 }
  );
  document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));

  /* Ambient parallax */
  const ambOrbs = [
    { el: document.getElementById("ambOrb1"), speed:  0.13 },
    { el: document.getElementById("ambOrb2"), speed: -0.09 },
    { el: document.getElementById("ambOrb3"), speed:  0.07 },
    { el: document.getElementById("ambOrb4"), speed:  0.15 },
  ];
  window.addEventListener("scroll", () => {
    const y = window.scrollY;
    ambOrbs.forEach(({ el, speed }) => {
      if (el) el.style.transform = `translateY(${y * speed}px)`;
    });
  }, { passive: true });
</script>
