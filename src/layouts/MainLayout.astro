---
import "../styles/global.css";

const title = "Okamed — Engenharia Clínica Moderna"
const description =
  "Engenharia clínica com tecnologia própria para gestão, manutenção e rastreabilidade de equipamentos médicos."
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>

  <body class="bg-slate-950 text-slate-100 antialiased">
    <slot />
  </body>
</html>