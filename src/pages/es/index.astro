---
import MainLayout from '../../layouts/MainLayout.astro';
import Hero from '../../components/Hero.astro';
import ServicesGrid from '../../components/ServicesGrid.astro';
import ArgosSection from '../../components/ArgosSection.astro';
import MapSection from '../../components/MapSection.astro';
import ContactSection from '../../components/ContactSection.astro';
import Footer from '../../components/Footer.astro';
---

<MainLayout title="Okamed — Ingeniería Clínica">
  <Hero subtitle="Reducimos riesgos operacionales, garantizamos conformidad regulatoria y aumentamos la eficiencia de su institución con tecnología propia.">
    <img src="/assets/astro.svg" alt="Ilustración digital sobre tecnología aplicada a la ingeniería clínica" class="w-full h-full object-cover" />
  </Hero>

  <div class="unified-bg">

    <div class="ub-canvas" aria-hidden="true">
      <div class="ub-sphere ubs-tr"></div>
      <div class="ub-sphere ubs-tl"></div>
      <div class="ub-sphere ubs-mr"></div>
      <div class="ub-sphere ubs-cl"></div>
      <div class="ub-sphere ubs-cc"></div>
      <div class="ub-sphere ubs-br"></div>
      <div class="ub-sphere ubs-bl"></div>
      <div class="ub-grid"></div>
    </div>

    <ServicesGrid />
    <ArgosSection />
    <MapSection />
  </div>

  <ContactSection />

<script is:inline>
(function () {
  const wrapper = document.querySelector('.unified-bg');
  if (!wrapper) return;

  const layers = [
    { sel: '.ubs-tr', speed: -0.18 },
    { sel: '.ubs-tl', speed:  0.12 },
    { sel: '.ubs-mr', speed: -0.10 },
    { sel: '.ubs-cl', speed:  0.15 },
    { sel: '.ubs-cc', speed: -0.08 },
    { sel: '.ubs-br', speed:  0.12 },
    { sel: '.ubs-bl', speed: -0.14 },
  ];

  const els = layers.map(l => ({
    el: wrapper.querySelector(l.sel),
    speed: l.speed,
    cur: 0,
    target: 0,
  }));

  function onScroll() {
    const rect   = wrapper.getBoundingClientRect();
    const scroll = -rect.top;
    els.forEach(e => { if (e.el) e.target = scroll * e.speed; });
  }

  function tick() {
    els.forEach(e => {
      if (!e.el) return;
      e.cur += (e.target - e.cur) * 0.06;
      e.el.style.transform = `translateY(${e.cur}px)`;
    });
    requestAnimationFrame(tick);
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  tick();
})();
</script>
  <Footer />
</MainLayout>

<style>
.unified-bg {
  position: relative;
  background: #EAF2F9;
  overflow: hidden;
}

.ub-canvas {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
}

.ub-sphere {
  position: absolute;
  border-radius: 50%;
  will-change: transform;
}

.ubs-tr {
  width: 1100px; height: 1100px;
  top: -220px; right: -250px;
  background: radial-gradient(circle at 32% 28%, #B8D9F2, #5BA4D4 48%, #2167A0 72%, transparent);
  opacity: 0.22;
  filter: blur(55px);
}

.ubs-tl {
  width: 520px; height: 520px;
  top: 60px; left: -90px;
  background: radial-gradient(circle at 42% 38%, #D4ECFA, #7CBCE8 58%, #4A9DCF);
  opacity: 0.14;
  filter: blur(75px);
}

.ubs-mr {
  width: 700px; height: 700px;
  top: 28%; right: -160px;
  background: radial-gradient(circle at 36% 32%, #C0DFF4, #5BA4D4 52%, #1E6699);
  opacity: 0.18;
  filter: blur(45px);
}

.ubs-cl {
  width: 800px; height: 800px;
  top: 42%; left: -80px;
  background: radial-gradient(circle at 50% 50%, rgba(184,217,242,0.75), rgba(91,164,212,0.35) 58%, transparent);
  opacity: 0.22;
  filter: blur(90px);
}

.ubs-cc {
  width: 1000px; height: 600px;
  top: 38%; left: calc(50% - 500px);
  background: radial-gradient(ellipse at 50% 50%, rgba(184,217,242,0.55), rgba(91,164,212,0.18) 65%, transparent);
  opacity: 0.18;
  filter: blur(110px);
}

.ubs-br {
  width: 650px; height: 650px;
  bottom: 0; right: -100px;
  background: radial-gradient(circle at 38% 30%, #C4DFF5, #5BA4D4 60%, transparent);
  opacity: 0.17;
  filter: blur(65px);
}

.ubs-bl {
  width: 550px; height: 550px;
  bottom: -60px; left: -70px;
  background: radial-gradient(circle at 45% 40%, #D0E8FA, #7CBCE8 55%, transparent);
  opacity: 0.13;
  filter: blur(70px);
}

.ub-grid {
  position: absolute; inset: 0;
  background-image:
    linear-gradient(rgba(41,112,163,0.055) 1px, transparent 1px),
    linear-gradient(90deg, rgba(41,112,163,0.055) 1px, transparent 1px);
  background-size: 56px 56px;
  mask-image:
    radial-gradient(ellipse 80% 40% at 70% 18%, black 0%, transparent 80%),
    radial-gradient(ellipse 60% 30% at 30% 55%, black 0%, transparent 75%),
    radial-gradient(ellipse 70% 35% at 60% 85%, black 0%, transparent 80%);
  mask-composite: add;
  -webkit-mask-image:
    radial-gradient(ellipse 80% 40% at 70% 18%, black 0%, transparent 80%),
    radial-gradient(ellipse 60% 30% at 30% 55%, black 0%, transparent 75%),
    radial-gradient(ellipse 70% 35% at 60% 85%, black 0%, transparent 80%);
  -webkit-mask-composite: source-over;
}
</style>
