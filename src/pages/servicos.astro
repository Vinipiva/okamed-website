---
import MainLayout from '../layouts/MainLayout.astro';
import Footer from '../components/Footer.astro';
import { useTranslations } from '../i18n/utils';

const t = useTranslations('pt');

const iconMap: Record<string, string> = {
  wrench: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.8-3.8a6 6 0 0 1-7.8 7.8l-6.2 6.2a2.1 2.1 0 0 1-3-3l6.2-6.2a6 6 0 0 1 7.8-7.8l-3.8 3.8z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  gauge: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M4 14a8 8 0 1 1 16 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M12 12l-3.5-3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><circle cx="12" cy="12" r="1.5" fill="currentColor"/></svg>`,
  hospital: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><rect x="3" y="7" width="18" height="14" rx="1.5" stroke="currentColor" stroke-width="1.5"/><path d="M8 21v-5h8v5M12 10v5M9.5 12.5h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M8 7V5a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2" stroke="currentColor" stroke-width="1.5"/></svg>`,
  purchase: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M3 3h2.5l3 10.5H18l2-7H8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><circle cx="10" cy="20" r="1.5" fill="currentColor"/><circle cx="16" cy="20" r="1.5" fill="currentColor"/></svg>`,
  lease: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><rect x="2" y="8" width="20" height="13" rx="1.5" stroke="currentColor" stroke-width="1.5"/><path d="M7 8V6a5 5 0 0 1 10 0v2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M9 14.5h6M12 12v5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>`,
  shield: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M12 2l8 3.5V11c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V5.5L12 2z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M8.5 12l2.5 2.5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  quality: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/><path d="M8 12l3 3 5-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  legal: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M12 3v18M6 6h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M4.5 9.5L2 16h5L4.5 9.5zM19.5 9.5L17 16h5L19.5 9.5z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>`,
  optics: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"/><path d="M2.5 12c2.5-5 5.5-7 9.5-7s7 2 9.5 7c-2.5 5-5.5 7-9.5 7s-7-2-9.5-7z" stroke="currentColor" stroke-width="1.5"/></svg>`,
  water: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M12 2C12 2 5 10 5 15a7 7 0 0 0 14 0c0-5-7-13-7-13z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M8.5 16.5a4 4 0 0 0 3.5 2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>`,
  training: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="7" r="3" stroke="currentColor" stroke-width="1.5"/><path d="M6 21v-3a6 6 0 0 1 12 0v3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M2 14.5h3M19 14.5h3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>`,
  regulatory: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><rect x="4" y="2" width="16" height="20" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M8 8h8M8 12h8M8 16h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>`,
  team: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="8" cy="7" r="3" stroke="currentColor" stroke-width="1.5"/><circle cx="16" cy="7" r="3" stroke="currentColor" stroke-width="1.5"/><path d="M2 21v-2a6 6 0 0 1 12 0v2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M18 14a6 6 0 0 1 4 5.5V21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>`,
  dental: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M8 2c-2.5 0-5 2-5 5 0 3.5 1.2 6 2.5 9.5.5 2 1.2 2.5 2.5 2.5 1 0 1.8-1 4-1s3 1 4 1c1.3 0 2-.5 2.5-2.5C19.8 13 21 10.5 21 7c0-3-2.5-5-5-5-1.2 0-2.5.5-4 .5S9.2 2 8 2z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>`,
  ups: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M12 9v3.5L9.5 16M12 12.5L14.5 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M8 5V3M16 5V3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>`,
  building: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><rect x="2" y="7" width="20" height="15" rx="1.5" stroke="currentColor" stroke-width="1.5"/><path d="M7 22v-5h4v5M13 22v-5h4v5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M2 12h20M7 7V4a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v3" stroke="currentColor" stroke-width="1.5"/></svg>`,
  tech: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><rect x="2" y="4" width="20" height="14" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M8 11l3 3-3 3M13 16h3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M7 21h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>`,
};
---

<MainLayout title="Serviços — Okamed Engenharia Clínica" description="Portfólio completo de soluções em engenharia clínica, tecnologia hospitalar e serviços especializados para instituições de saúde.">

  <!-- Nav simples de volta -->
  <header class="page-header">
    <div class="page-header-inner">
      <a href="/" class="back-link">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M12 8H4M7 4l-4 4 4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Okamed
      </a>
      <a href="/#contato" class="header-cta">Falar com especialista</a>
    </div>
  </header>

  <main class="services-page" id="main-content" tabindex="-1">

    <!-- Hero da página -->
    <section class="page-hero">
      <div class="page-hero-inner">
        <p class="page-eyebrow">Soluções</p>
        <h1 class="page-title">Portfólio<br/><span class="title-light">de serviços</span></h1>
        <p class="page-subtitle">
          Da manutenção de equipamentos críticos à consultoria regulatória —
          soluções completas para a sua instituição de saúde.
        </p>
      </div>
      <div class="page-hero-decoration" aria-hidden="true">
        <div class="hero-orb-1"></div>
        <div class="hero-orb-2"></div>
      </div>
    </section>

    <!-- Grid principal de serviços -->
    <section class="services-main">
      <div class="services-container">

        <div class="services-grid">
          {t.services.services.map((s: { label: string; desc: string; detail?: string; icon?: string }, i: number) => (
            <article class="service-card" style={`--delay: ${i * 0.04}s`}>
              <div class="card-icon-wrap" aria-hidden="true">
                <Fragment set:html={iconMap[s.icon ?? 'regulatory']} />
              </div>
              <div class="card-body">
                <h3 class="card-title">{s.label}</h3>
                <p class="card-desc">{s.desc}</p>
                {s.detail && (
                  <p class="card-detail">{s.detail}</p>
                )}
              </div>
            </article>
          ))}
        </div>

      </div>
    </section>

    <!-- CTA final -->
    <section class="page-cta-section">
      <div class="page-cta-inner">
        <p class="page-cta-label">Pronto para conversar?</p>
        <h2 class="page-cta-title">Encontre a solução certa<br/>para sua instituição.</h2>
        <a href="https://wa.me/5517996107866" target="_blank" rel="noopener" class="page-cta-btn">
          Falar com um especialista
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M2 8h12M10 4l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </section>

  </main>

  <Footer />
</MainLayout>

<style>
/* ── PAGE HEADER ── */
.page-header {
  position: sticky; top: 0; z-index: 50;
  background: rgba(244,246,248,0.85);
  backdrop-filter: blur(16px);
  border-bottom: 1px solid rgba(11,46,78,0.08);
}

.page-header-inner {
  max-width: 1200px; margin: 0 auto;
  padding: 0 24px;
  height: 56px;
  display: flex; align-items: center; justify-content: space-between;
}

.back-link {
  display: inline-flex; align-items: center; gap: 7px;
  font-size: 0.875rem; font-weight: 500;
  color: var(--okamed-deep); text-decoration: none; opacity: 0.65;
  transition: opacity 0.2s;
}
.back-link:hover { opacity: 1; }

.header-cta {
  font-size: 0.875rem; font-weight: 600;
  color: var(--okamed-accent); text-decoration: none;
  border: 1px solid rgba(41,112,163,0.25);
  border-radius: 8px; padding: 7px 16px;
  transition: background 0.2s, border-color 0.2s;
}
.header-cta:hover {
  background: rgba(41,112,163,0.07);
  border-color: rgba(41,112,163,0.4);
}

/* ── HERO ── */
.services-page { min-height: 100vh; }

.page-hero {
  position: relative; overflow: hidden;
  padding: 80px 24px 72px;
  background: linear-gradient(160deg, #0B2E4E 0%, #0f3a5e 60%, #1a4f7a 100%);
}

.page-hero-inner {
  position: relative; z-index: 2;
  max-width: 1200px; margin: 0 auto;
}

.page-eyebrow {
  font-size: 0.875rem; font-weight: 700; letter-spacing: 0.15em;
  text-transform: uppercase; color: rgba(110,182,255,0.85);
  margin-bottom: 20px;
}

.page-title {
  font-size: clamp(2.8rem, 6vw, 5rem);
  font-weight: 700; letter-spacing: -0.04em;
  line-height: 1.0; color: #fff; margin-bottom: 20px;
}

.title-light { font-weight: 200; color: rgba(255,255,255,0.7); }

.page-subtitle {
  font-size: 1rem; color: rgba(180,215,255,0.65);
  line-height: 1.65; max-width: 520px;
}

.page-hero-decoration {
  position: absolute; inset: 0; pointer-events: none;
}

.hero-orb-1 {
  position: absolute; top: -100px; right: -80px;
  width: 600px; height: 600px; border-radius: 50%;
  background: radial-gradient(circle at 38% 35%, #2970A3, #1E537E 45%, transparent 70%);
  opacity: 0.35; filter: blur(60px);
}

.hero-orb-2 {
  position: absolute; bottom: -60px; left: 20%;
  width: 400px; height: 400px; border-radius: 50%;
  background: radial-gradient(circle, #1E537E, transparent 70%);
  opacity: 0.2; filter: blur(80px);
}

/* ── SERVICES GRID ── */
.services-main {
  background: #EAF2F9;
  padding: 64px 24px 80px;
}

.services-container { max-width: 1200px; margin: 0 auto; }

.services-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}

.service-card {
  display: flex; gap: 18px;
  padding: 28px 26px;
  border-radius: 20px;
  background: rgba(255,255,255,0.65);
  border: 1px solid rgba(255,255,255,0.90);
  box-shadow: 0 2px 16px rgba(11,46,78,0.05);
  backdrop-filter: blur(12px);
  transition: transform 0.25s, box-shadow 0.25s, background 0.25s, border-color 0.25s;
  animation: fadeUp 0.4s ease both;
  animation-delay: var(--delay, 0s);
}

.service-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 36px rgba(11,46,78,0.10);
  background: rgba(255,255,255,0.88);
  border-color: rgba(41,112,163,0.18);
}

.card-icon-wrap {
  flex-shrink: 0; width: 44px; height: 44px;
  border-radius: 12px;
  background: rgba(41,112,163,0.07);
  border: 1px solid rgba(41,112,163,0.12);
  display: flex; align-items: center; justify-content: center;
  color: var(--okamed-accent); margin-top: 1px;
  transition: background 0.25s, border-color 0.25s;
}

.service-card:hover .card-icon-wrap {
  background: rgba(41,112,163,0.12);
  border-color: rgba(41,112,163,0.22);
}

.card-body { flex: 1; }

.card-title {
  font-size: 0.875rem; font-weight: 600;
  color: var(--okamed-deep); margin-bottom: 6px;
  line-height: 1.3;
}

.card-desc {
  font-size: 0.875rem; color: #475569;
  line-height: 1.55; margin-bottom: 0;
}

.card-detail {
  font-size: 0.875rem; color: #64748b;
  line-height: 1.6; margin-top: 10px;
  padding-top: 10px;
  border-top: 1px solid rgba(41,112,163,0.08);
}

.card-title-row {
  display: flex; align-items: center; gap: 8px;
  flex-wrap: wrap; margin-bottom: 6px;
}

.card-title { margin-bottom: 0; }

.card-partner-badge {
  font-size: 0.875rem; font-weight: 700; letter-spacing: 0.1em;
  text-transform: uppercase; color: var(--okamed-accent);
  background: rgba(41,112,163,0.08);
  border: 1px solid rgba(41,112,163,0.18);
  border-radius: 5px; padding: 3px 10px;
  flex-shrink: 0;
}

.card-partner-link {
  display: inline-flex; align-items: center; gap: 5px;
  font-size: 0.875rem; font-weight: 500;
  color: var(--okamed-accent); text-decoration: none;
  margin-top: 12px;
  opacity: 0.85; transition: opacity 0.2s, gap 0.2s;
}

.card-partner-link:hover { opacity: 1; gap: 8px; }

.service-card--partner {
  border-color: rgba(41,112,163,0.18);
  background: rgba(41,112,163,0.03);
}

/* ── CTA FINAL ── */
.page-cta-section {
  background: #0B2E4E;
  padding: 80px 24px;
}

.page-cta-inner {
  max-width: 1200px; margin: 0 auto;
  text-align: center;
}

.page-cta-label {
  font-size: 0.875rem; font-weight: 700; letter-spacing: 0.15em;
  text-transform: uppercase; color: rgba(110,182,255,0.8);
  margin-bottom: 16px;
}

.page-cta-title {
  font-size: clamp(1.8rem, 4vw, 3rem);
  font-weight: 300; letter-spacing: -0.03em;
  color: #fff; line-height: 1.15; margin-bottom: 36px;
}

.page-cta-btn {
  display: inline-flex; align-items: center; gap: 10px;
  font-size: 0.875rem; font-weight: 600;
  color: #fff; text-decoration: none;
  background: var(--okamed-accent);
  border-radius: 12px; padding: 14px 28px;
  transition: opacity 0.2s, gap 0.2s;
}

.page-cta-btn:hover { opacity: 0.88; gap: 14px; }

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(16px); }
  to   { opacity: 1; transform: translateY(0); }
}

@media (max-width: 1000px) {
  .services-grid { grid-template-columns: repeat(2, 1fr); }
  .partner-card { grid-template-columns: 1fr; gap: 20px; }
  .partner-card-left { min-width: auto; }
}

@media (max-width: 640px) {
  .services-grid { grid-template-columns: 1fr; }
  .page-title { font-size: 2.5rem; }
  .service-card { flex-direction: column; }
}
</style>
