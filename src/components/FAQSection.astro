---
import { useTranslations } from "../i18n/utils";
const t = useTranslations(Astro.currentLocale ?? (Astro.url.pathname.startsWith('/es/') ? 'es' : 'pt'));

const faqs = [
  {
    question_pt: "¿Qué es la ingeniería clínica?",
    question_es: "¿Qué es la ingeniería clínica?",
    answer_pt: "A engenharia clínica é a aplicação de princípios de engenharia e tecnologia para resolver problemas no setor de saúde, incluindo gestão, manutenção e otimização de equipamentos médicos em instituições.",
    answer_es: "La ingeniería clínica es la aplicación de principios de ingeniería y tecnología para resolver problemas en el sector sanitario, incluida la gestión, mantenimiento y optimización de equipos médicos en instituciones."
  },
  {
    question_pt: "Como o Argos melhora a conformidade regulatória?",
    question_es: "¿Cómo mejora Argos el cumplimiento normativo?",
    answer_pt: "A plataforma Argos oferece rastreamento completo de equipamentos, histórico de manutenção, alertas de vencimento de calibrações e relatórios automatizados que facilitam auditorias e demonstram conformidade com normas como ISO 13485 e ANVISA.",
    answer_es: "La plataforma Argos ofrece rastreo completo de equipos, historial de mantenimiento, alertas de vencimiento de calibraciones e informes automatizados que facilitan auditorías y demuestran cumplimiento con estándares como ISO 13485 y ANVISA."
  },
  {
    question_pt: "Qual é o tempo de implementação?",
    question_es: "¿Cuál es el tiempo de implementación?",
    answer_pt: "A implementação típica leva entre 4 a 8 semanas, dependendo do tamanho da instituição e da quantidade de equipamentos. Oferecemos suporte completo durante todo o processo de migração de dados.",
    answer_es: "La implementación típica toma entre 4 a 8 semanas, dependiendo del tamaño de la institución y la cantidad de equipos. Ofrecemos soporte completo durante todo el proceso de migración de datos."
  },
  {
    question_pt: "A plataforma é segura e cumpre com a LGPD?",
    question_es: "¿Es la plataforma segura y cumple con la LGPD?",
    answer_pt: "Sim. Implementamos criptografia end-to-end, armazenamento criptografado em repouso, controle de acesso granular e auditorias de segurança regulares. Somos plenamente conformes com a LGPD e possuímos um DPO dedicado.",
    answer_es: "Sí. Implementamos encriptación de extremo a extremo, almacenamiento encriptado en reposo, control de acceso granular y auditorías de seguridad regulares. Somos totalmente conformes con la LGPD y tenemos un DPO dedicado."
  },
  {
    question_pt: "Qual é o custo de implementação?",
    question_es: "¿Cuál es el costo de implementación?",
    answer_pt: "O custo varia conforme o número de equipamentos e funcionalidades. Oferecemos modelos de preço flexíveis (assinatura, perpetual, híbrido) e uma análise ROI que demonstra retorno em 6-12 meses através de redução de custos operacionais.",
    answer_es: "El costo varía según el número de equipos y funcionalidades. Ofrecemos modelos de precios flexibles (suscripción, perpetuo, híbrido) y un análisis de ROI que demuestra rentabilidad en 6-12 meses mediante la reducción de costos operacionales."
  },
  {
    question_pt: "Oferecemos suporte 24/7?",
    question_es: "¿Ofrecen soporte 24/7?",
    answer_pt: "Sim. Temos suporte técnico 24/7, canais de comunicação múltiplos (chat, email, telefone) e tempos de resposta garantidos de acordo com o plano contratado. Incluímos treinamento e documentação para sua equipe.",
    answer_es: "Sí. Tenemos soporte técnico 24/7, múltiples canales de comunicación (chat, correo electrónico, teléfono) y tiempos de respuesta garantizados según el plan contratado. Incluimos capacitación y documentación para su equipo."
  }
];
---

<section id="faq" class="relative py-28 px-6 bg-white">
  <div class="max-w-4xl mx-auto">

    <!-- Header -->
    <div class="mb-16 reveal text-center">
      <p class="section-label mb-4">{t.locale === 'es' ? 'Preguntas Frecuentes' : 'Perguntas Frequentes'}</p>
      <h2 class="section-title">
        {t.locale === 'es' 
          ? 'FAQ — Preguntas comunes respondidas'
          : 'FAQ — Perguntas comuns respondidas'}
      </h2>
      <p class="text-slate-500 mt-6 max-w-2xl mx-auto leading-relaxed">
        {t.locale === 'es' 
          ? 'Encuentre respuestas a las preguntas más frecuentes sobre nuestras soluciones de ingeniería clínica.'
          : 'Encontre respostas às perguntas mais frequentes sobre nossas soluções de engenharia clínica.'}
      </p>
    </div>

    <!-- FAQ Accordion -->
    <div class="space-y-4">
      {faqs.map((faq, idx) => (
        <details class="faq-item reveal" style={`--delay: ${idx + 1}`}>
          <summary class="faq-question">
            {t.locale === 'es' ? faq.question_es : faq.question_pt}
            <svg class="faq-icon" width="20" height="20" viewBox="0 0 20 20" fill="none">
              <path d="M7.5 8L10 10.5l2.5-2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </summary>
          <div class="faq-answer">
            {t.locale === 'es' ? faq.answer_es : faq.answer_pt}
          </div>
        </details>
      ))}
    </div>

    <!-- CTA -->
    <div class="mt-16 p-8 bg-gradient-to-r from-[#0B2E4E] to-[#1E537E] rounded-2xl text-white text-center reveal delay-8">
      <h3 class="text-2xl font-semibold mb-4">
        {t.locale === 'es' ? 'Ainda tem dúvidas?' : '¿Aún tiene preguntas?'}
      </h3>
      <p class="mb-6 opacity-90">
        {t.locale === 'es' 
          ? 'Nuestro equipo de especialistas está disponible para ayudarle'
          : 'Nosso time de especialistas está disponível para ajudá-lo'}
      </p>
      <a href="#contato" class="inline-block px-6 py-3 bg-white text-[#0B2E4E] font-semibold rounded-lg hover:bg-slate-100 transition-colors">
        {t.locale === 'es' ? 'Fale com um especialista' : 'Hablar con un especialista'}
      </a>
    </div>

  </div>
</section>

<style>
.faq-item {
  border: 1px solid rgba(11, 46, 78, 0.08);
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.95);
  transition: all 0.3s ease;
  animation: floatUp 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
  animation-delay: calc(var(--delay, 0) * 0.08s);
}

.faq-item:hover {
  border-color: rgba(41, 112, 163, 0.20);
  box-shadow: 0 8px 24px rgba(11, 46, 78, 0.06);
}

.faq-item[open] {
  border-color: rgba(41, 112, 163, 0.25);
  background: rgba(255, 255, 255, 1);
}

.faq-question {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18px 20px;
  cursor: pointer;
  font-weight: 600;
  color: #0B2E4E;
  font-size: 1rem;
  list-style: none;
  user-select: none;
  transition: color 0.2s ease;
}

.faq-question:hover {
  color: #2970A3;
}

.faq-item[open] .faq-question {
  color: #2970A3;
}

.faq-icon {
  flex-shrink: 0;
  color: #2970A3;
  transition: transform 0.3s ease;
  transform-origin: center;
}

.faq-item[open] .faq-icon {
  transform: rotate(180deg);
}

.faq-answer {
  padding: 0 20px 18px 20px;
  color: #64748b;
  line-height: 1.6;
  font-size: 0.95rem;
  animation: slideDown 0.3s ease-out;
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes floatUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Remove seta padrão em navegadores webkit */
.faq-question::-webkit-details-marker {
  display: none;
}
</style>
