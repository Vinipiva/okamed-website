---
import { useTranslations } from "../i18n/utils";

const t = useTranslations(Astro.currentLocale);

const serviceIcons = [
  `<svg width="20" height="20" viewBox="0 0 22 22" fill="none"><path d="M13.7 5.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.5-3.5a5.5 5.5 0 0 1-7.3 7.3l-6.4 6.4a2 2 0 0 1-2.8-2.8l6.4-6.4a5.5 5.5 0 0 1 7.3-7.3l-3.7 3.3z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  `<svg width="20" height="20" viewBox="0 0 22 22" fill="none"><circle cx="11" cy="11" r="3" stroke="currentColor" stroke-width="1.5"/><path d="M11 2v2M11 18v2M2 11h2M18 11h2M4.93 4.93l1.41 1.41M15.66 15.66l1.41 1.41M4.93 17.07l1.41-1.41M15.66 6.34l1.41-1.41" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>`,
  `<svg width="20" height="20" viewBox="0 0 22 22" fill="none"><path d="M4 6h14M4 11h14M4 16h9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><circle cx="18" cy="16" r="2.5" stroke="currentColor" stroke-width="1.5"/></svg>`,
  `<svg width="20" height="20" viewBox="0 0 22 22" fill="none"><path d="M8 3H5a2 2 0 0 0-2 2v4m5-6h9a2 2 0 0 1 2 2v4M8 3v16m0 0h9a2 2 0 0 0 2-2v-4M8 19H5a2 2 0 0 1-2-2v-4m0 0h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
];
---

<section id="servicos" class="relative py-28 px-6 bg-transparent">
  <div class="max-w-7xl mx-auto">

    <!-- Header -->
    <div class="mb-14 reveal">
      <p class="section-label mb-4">{t.services.sectionLabel}</p>
      <h2 class="section-title max-w-2xl">
        {t.services.sectionTitle.split('\n').map((line: string, i: number) => (
          <>
            {i > 0 && <br class="hidden sm:block"/>}
            {line}
          </>
        ))}
      </h2>
    </div>

    <!-- Bento grid principal -->
    <div class="bento-grid reveal delay-1">

      <!-- Card principal -->
      <div class="bento-field">
        <div class="field-bg" aria-hidden="true">
          <div class="field-grid-lines"></div>
          <div class="field-orb"></div>
        </div>

        <div class="field-content">
          <div class="field-badges">
            <span class="field-badge">
              <svg width="11" height="11" viewBox="0 0 12 12" fill="none">
                <circle cx="6" cy="6" r="4" stroke="currentColor" stroke-width="1.3"/>
                <path d="M2 6h8M6 2a8 8 0 0 1 2 4 8 8 0 0 1-2 4 8 8 0 0 1-2-4 8 8 0 0 1 2-4z" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
              </svg>
              {t.services.regionBadge}
            </span>
            <span class="field-badge-accent">{t.services.complexityBadge}</span>
          </div>

          <h3 class="field-title">
            {t.services.fieldTitle.split('\n').map((line: string, i: number) => (
              <>
                {i > 0 && <br/>}
                {line}
              </>
            ))}
          </h3>

          <p class="field-desc">{t.services.fieldDesc}</p>

        </div>
      </div>

      <!-- Card Argos -->
      <a href="https://argos.okamed.com.br/" target="_blank" rel="noopener" class="bento-argos group" aria-label={t.services.argosCta}>
        <div class="argos-badge">{t.services.argosBadge}</div>

        <div class="argos-icon-wrap" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
            <rect x="6" y="2" width="16" height="24" rx="3" stroke="currentColor" stroke-width="1.5"/>
            <path d="M10 6h8M10 10h5M14 20a1 1 0 1 0 0 2 1 1 0 0 0 0-2z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </div>

        <h3 class="argos-title">App <span class="argos-name">Argos</span></h3>
        <p class="argos-desc">{t.services.argosDesc}</p>

        <div class="argos-cta">
          <span>{t.services.argosCta}</span>
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      </a>

    </div>

    <!-- Serviços secundários -->
    <div class="services-row">
      {t.services.services.map((s: { label: string; desc: string }, i: number) => (
        <div class={`service-mini reveal delay-${i + 2}`}>
          <div class="service-mini-icon">
            <Fragment set:html={serviceIcons[i]} />
          </div>
          <div>
            <p class="service-mini-label">{s.label}</p>
            <p class="service-mini-desc">{s.desc}</p>
          </div>
        </div>
      ))}
    </div>

  </div>

  <!-- Equipamentos indexáveis pelo Google, invisíveis na UI -->
  <div class="sr-only" aria-hidden="true">
    <p>{t.services.equipmentIntro}</p>
    {t.services.equipmentGroups.map((group: { label: string; items: string[] }) => (
      <div>
        <p>{group.label}:</p>
        <ul>
          {group.items.map((item: string) => <li>{item}</li>)}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
/* ── BENTO GRID ── */
.bento-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 16px;
  margin-bottom: 16px;
}

/* ── CARD FIELD ── */
.bento-field {
  grid-column: span 2;
  position: relative;
  border-radius: 24px;
  overflow: hidden;
  background: #0B2E4E;
  min-height: 420px;
  padding: 44px 48px;
}

.field-bg {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.field-grid-lines {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(255,255,255,0.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.035) 1px, transparent 1px);
  background-size: 52px 52px;
}

.field-orb {
  position: absolute;
  bottom: -140px;
  right: -100px;
  width: 520px;
  height: 520px;
  border-radius: 50%;
  background: radial-gradient(circle at 40% 40%, #2970A3 0%, #1E537E 40%, transparent 70%);
  opacity: 0.40;
  filter: blur(70px);
}

.field-content {
  position: relative;
  z-index: 2;
}

.field-badges {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 22px;
  flex-wrap: wrap;
}

.field-badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: 0.6rem;
  font-weight: 600;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: rgba(180, 215, 255, 0.85);
  border: 1px solid rgba(255,255,255,0.18);
  border-radius: 6px;
  padding: 4px 10px;
  background: rgba(255,255,255,0.04);
}

.field-badge-accent {
  display: inline-flex;
  align-items: center;
  font-size: 0.6rem;
  font-weight: 700;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: rgba(110, 182, 255, 0.80);
  border: 1px solid rgba(110, 182, 255, 0.20);
  border-radius: 6px;
  padding: 4px 10px;
  background: rgba(41, 112, 163, 0.18);
}

.field-title {
  font-size: clamp(2rem, 3.5vw, 3.2rem);
  font-weight: 200;
  letter-spacing: -0.03em;
  line-height: 1.08;
  color: #fff;
  margin-bottom: 18px;
}

.field-desc {
  font-size: 0.875rem;
  color: rgba(180, 215, 255, 0.65);
  line-height: 1.65;
  max-width: 360px;
  margin-bottom: 28px;
}

/* Equipamentos por categoria */
.equip-groups {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px 24px;
}

.equip-group-label {
  font-size: 0.58rem;
  font-weight: 700;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: rgba(110, 182, 255, 0.65);
  margin-bottom: 8px;
}

.equip-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
}

.equip-tag {
  font-size: 0.65rem;
  font-weight: 500;
  color: rgba(180, 215, 255, 0.85);
  border: 1px solid rgba(255,255,255,0.14);
  border-radius: 6px;
  padding: 3px 9px;
  background: rgba(255,255,255,0.07);
}

/* ── CARD ARGOS ── */
.bento-argos {
  grid-column: span 1;
  display: flex;
  flex-direction: column;
  border-radius: 24px;
  background: rgba(255,255,255,0.62);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255,255,255,0.85);
  box-shadow: 0 4px 24px rgba(11,46,78,0.08);
  padding: 36px 36px 32px;
  text-decoration: none;
  transition: box-shadow 0.3s, transform 0.3s, border-color 0.3s, background 0.3s;
  cursor: pointer;
  position: relative;
  overflow: hidden;
}

.bento-argos::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: linear-gradient(135deg, rgba(41,112,163,0.04) 0%, transparent 60%);
  pointer-events: none;
}

.bento-argos:hover {
  background: rgba(255,255,255,0.90);
  box-shadow: 0 20px 56px rgba(11,46,78,0.15);
  transform: translateY(-5px);
  border-color: rgba(41,112,163,0.22);
}

.argos-badge {
  display: inline-flex;
  align-self: flex-start;
  font-size: 0.6rem;
  font-weight: 700;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--okamed-accent);
  background: rgba(41,112,163,0.09);
  border: 1px solid rgba(41,112,163,0.18);
  border-radius: 6px;
  padding: 4px 10px;
  margin-bottom: 28px;
}

.argos-icon-wrap {
  width: 52px;
  height: 52px;
  border-radius: 14px;
  background: rgba(41,112,163,0.08);
  border: 1px solid rgba(41,112,163,0.14);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--okamed-accent);
  margin-bottom: 18px;
  transition: background 0.3s, border-color 0.3s;
}

.bento-argos:hover .argos-icon-wrap {
  background: rgba(41,112,163,0.14);
  border-color: rgba(41,112,163,0.26);
}

.argos-title {
  font-size: 1.75rem;
  font-weight: 300;
  letter-spacing: -0.02em;
  color: var(--okamed-deep);
  margin-bottom: 12px;
}

.argos-name {
  font-weight: 600;
  color: var(--okamed-accent);
}

.argos-desc {
  font-size: 0.8375rem;
  color: #64748b;
  line-height: 1.65;
  flex: 1;
  margin-bottom: 28px;
}

.argos-cta {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  font-size: 0.8rem;
  font-weight: 500;
  color: var(--okamed-accent);
  margin-top: auto;
  transition: gap 0.2s;
}

.bento-argos:hover .argos-cta {
  gap: 11px;
}

/* ── SERVICES ROW ── */
.services-row {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
}

.service-mini {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  padding: 20px 22px;
  border-radius: 18px;
  background: rgba(255,255,255,0.58);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255,255,255,0.80);
  box-shadow: 0 2px 12px rgba(11,46,78,0.05);
  transition: background 0.25s, box-shadow 0.25s, transform 0.25s, border-color 0.25s;
}

.service-mini:hover {
  background: rgba(255,255,255,0.88);
  box-shadow: 0 8px 28px rgba(11,46,78,0.10);
  transform: translateY(-3px);
  border-color: rgba(41,112,163,0.16);
}

.service-mini-icon {
  flex-shrink: 0;
  width: 38px;
  height: 38px;
  border-radius: 10px;
  background: rgba(41,112,163,0.07);
  border: 1px solid rgba(41,112,163,0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--okamed-accent);
  margin-top: 1px;
  transition: background 0.25s, border-color 0.25s;
}

.service-mini:hover .service-mini-icon {
  background: rgba(41,112,163,0.12);
  border-color: rgba(41,112,163,0.22);
}

.service-mini-label {
  font-size: 0.8125rem;
  font-weight: 600;
  color: var(--okamed-deep);
  margin-bottom: 4px;
}

.service-mini-desc {
  font-size: 0.75rem;
  color: #64748b;
  line-height: 1.55;
}

/* ── RESPONSIVE ── */
@media (max-width: 900px) {
  .bento-grid {
    grid-template-columns: 1fr;
  }

  .bento-field {
    grid-column: span 1;
    min-height: 340px;
    padding: 36px 32px;
  }

  .bento-argos {
    grid-column: span 1;
  }

  .services-row {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 600px) {
  .services-row {
    grid-template-columns: 1fr;
  }

  .field-title {
    font-size: 2.2rem;
  }
}
</style>
