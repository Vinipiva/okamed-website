---
import { useTranslations } from "../i18n/utils";

const t = useTranslations(Astro.currentLocale ?? (Astro.url.pathname.startsWith('/es/') ? 'es' : 'pt'));

const iconMap: Record<string, string> = {
  wrench: `<svg width="18" height="18" viewBox="0 0 20 20" fill="none"><path d="M14.5 2.5a3.5 3.5 0 0 1 .5 6.9L8 16.5a2 2 0 1 1-2.8-2.8l7.1-7a3.5 3.5 0 0 1 2.2-4.2z" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  gauge: `<svg width="18" height="18" viewBox="0 0 20 20" fill="none"><path d="M3.5 13a7 7 0 1 1 13 0" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><path d="M10 10l-3-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><circle cx="10" cy="10" r="1.2" fill="currentColor"/></svg>`,
  hospital: `<svg width="18" height="18" viewBox="0 0 20 20" fill="none"><rect x="3" y="6" width="14" height="12" rx="1.5" stroke="currentColor" stroke-width="1.4"/><path d="M7 18v-4h6v4M10 9v4M8 11h4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><path d="M7 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" stroke="currentColor" stroke-width="1.4"/></svg>`,
  purchase: `<svg width="18" height="18" viewBox="0 0 20 20" fill="none"><path d="M3 3h2l2.5 9h8l1.5-6H7.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/><circle cx="9" cy="16.5" r="1.2" fill="currentColor"/><circle cx="14" cy="16.5" r="1.2" fill="currentColor"/></svg>`,
  tech: `<svg width="18" height="18" viewBox="0 0 20 20" fill="none"><rect x="2" y="4" width="16" height="11" rx="1.5" stroke="currentColor" stroke-width="1.4"/><path d="M7 9l2 2-2 2M11 13h2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/><path d="M6 17h8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>`,
};

const featuredServices = t.services.services.slice(0, 4);
---

<section id="servicos" class="relative py-28 px-6 bg-transparent services-section">
  <div class="max-w-7xl mx-auto">

    <!-- Header -->
    <div class="mb-14 reveal">
      <p class="section-label mb-4">{t.services.sectionLabel}</p>
      <h2 class="section-title max-w-2xl">
        {t.services.sectionTitle.split('\n').map((line: string, i: number) => (
          <>
            {i > 0 && <br class="hidden sm:block"/>}
            {line}
          </>
        ))}
      </h2>
    </div>

    <!-- Bento grid principal -->
    <div class="bento-grid reveal delay-1">
      <div class="bento-field">
        <div class="field-bg" aria-hidden="true">
          <div class="field-grid-lines"></div>
          <div class="field-orb"></div>
        </div>
        <div class="field-content">
          <div class="field-badges">
            <span class="field-badge">
              <svg width="11" height="11" viewBox="0 0 12 12" fill="none">
                <circle cx="6" cy="6" r="4" stroke="currentColor" stroke-width="1.3"/>
                <path d="M2 6h8M6 2a8 8 0 0 1 2 4 8 8 0 0 1-2 4 8 8 0 0 1-2-4 8 8 0 0 1 2-4z" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
              </svg>
              {t.services.regionBadge}
            </span>
            <span class="field-badge-accent">{t.services.complexityBadge}</span>
          </div>
          <h3 class="field-title">
            {t.services.fieldTitle.split('\n').map((line: string, i: number) => (
              <>
                {i > 0 && <br/>}
                {line}
              </>
            ))}
          </h3>
          <p class="field-desc">{t.services.fieldDesc}</p>
        </div>
      </div>

      <a href="https://argos.okamed.com.br/" target="_blank" rel="noopener" class="bento-argos group" aria-label={t.services.argosCta}>
        <div class="argos-badge">{t.services.argosBadge}</div>
        <div class="argos-icon-wrap" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
            <rect x="5" y="2" width="14" height="20" rx="2.5" stroke="currentColor" stroke-width="1.5"/>
            <path d="M9 6h6M9 9h4M12 17a1 1 0 1 0 0 2 1 1 0 0 0 0-2z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </div>
        <h3 class="argos-title">App <span class="argos-name">Argos</span></h3>
        <p class="argos-desc">{t.services.argosDesc}</p>
        <div class="argos-cta">
          <span>{t.services.argosCta}</span>
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      </a>
    </div>

    <!-- 4 serviços principais -->
    <div class="services-row">
      {featuredServices.map((s: { label: string; desc: string; icon?: string }, i: number) => (
        <div class={`service-mini reveal delay-${i + 2}`}>
          <div class="service-mini-icon" aria-hidden="true">
            <Fragment set:html={iconMap[s.icon ?? 'wrench']} />
          </div>
          <div>
            <p class="service-mini-label">{s.label}</p>
            <p class="service-mini-desc">{s.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- CTA sutil para ver todos -->
    <div class="all-services-cta reveal delay-6">
      <a href="/servicos" class="all-services-link">
        {t.services.allServicesLink}
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
          <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

  </div>

  <div class="sr-only" aria-hidden="true">
    <p>{t.services.equipmentIntro}</p>
    {t.services.equipmentGroups.map((group: { label: string; items: string[] }) => (
      <div>
        <p>{group.label}:</p>
        <ul>{group.items.map((item: string) => <li>{item}</li>)}</ul>
      </div>
    ))}
  </div>
</section>

<style>
.bento-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 16px;
  margin-bottom: 16px;
}

.bento-field {
  grid-column: span 2;
  position: relative;
  border-radius: 24px;
  overflow: hidden;
  background: #0B2E4E;
  min-height: 420px;
  padding: 44px 48px;
}

.field-bg { position: absolute; inset: 0; pointer-events: none; }

.field-grid-lines {
  position: absolute; inset: 0;
  background-image:
    linear-gradient(rgba(255,255,255,0.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.035) 1px, transparent 1px);
  background-size: 52px 52px;
}

.field-orb {
  position: absolute;
  bottom: -140px; right: -100px;
  width: 520px; height: 520px;
  border-radius: 50%;
  background: radial-gradient(circle at 40% 40%, #2970A3 0%, #1E537E 40%, transparent 70%);
  opacity: 0.40;
  filter: blur(70px);
}

.field-content { position: relative; z-index: 2; }

.field-badges {
  display: flex; align-items: center; gap: 8px;
  margin-bottom: 22px; flex-wrap: wrap;
}

.field-badge {
  display: inline-flex; align-items: center; gap: 5px;
  font-size: 0.875rem; font-weight: 600; letter-spacing: 0.12em;
  text-transform: uppercase; color: rgba(180,215,255,0.90);
  border: 1px solid rgba(255,255,255,0.18); border-radius: 6px;
  padding: 5px 12px; background: rgba(255,255,255,0.04);
}

.field-badge-accent {
  display: inline-flex; align-items: center;
  font-size: 0.875rem; font-weight: 700; letter-spacing: 0.12em;
  text-transform: uppercase; color: rgba(110,182,255,0.90);
  border: 1px solid rgba(110,182,255,0.20); border-radius: 6px;
  padding: 5px 12px; background: rgba(41,112,163,0.18);
}

.field-title {
  font-size: clamp(2rem, 3.5vw, 3.2rem);
  font-weight: 200; letter-spacing: -0.03em;
  line-height: 1.08; color: #fff; margin-bottom: 18px;
}

.field-desc {
  font-size: 0.875rem; color: rgba(180,215,255,0.65);
  line-height: 1.65; max-width: 360px; margin-bottom: 28px;
}

.bento-argos {
  grid-column: span 1;
  display: flex; flex-direction: column;
  border-radius: 24px;
  background: rgba(255,255,255,0.62);
  backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255,255,255,0.85);
  box-shadow: 0 4px 24px rgba(11,46,78,0.08);
  padding: 36px 36px 32px;
  text-decoration: none;
  transition: box-shadow 0.3s, transform 0.3s, border-color 0.3s, background 0.3s;
  position: relative; overflow: hidden;
}

.bento-argos::after {
  content: ""; position: absolute; inset: 0; border-radius: inherit;
  background: linear-gradient(135deg, rgba(41,112,163,0.04) 0%, transparent 60%);
  pointer-events: none;
}

.bento-argos:hover {
  background: rgba(255,255,255,0.90);
  box-shadow: 0 20px 56px rgba(11,46,78,0.15);
  transform: translateY(-5px);
  border-color: rgba(41,112,163,0.22);
}

.argos-badge {
  display: inline-flex; align-self: flex-start;
  font-size: 0.875rem; font-weight: 700; letter-spacing: 0.12em;
  text-transform: uppercase; color: var(--okamed-accent);
  background: rgba(41,112,163,0.09); border: 1px solid rgba(41,112,163,0.18);
  border-radius: 6px; padding: 5px 12px; margin-bottom: 28px;
}

.argos-icon-wrap {
  width: 52px; height: 52px; border-radius: 14px;
  background: rgba(41,112,163,0.08); border: 1px solid rgba(41,112,163,0.14);
  display: flex; align-items: center; justify-content: center;
  color: var(--okamed-accent); margin-bottom: 18px;
  transition: background 0.3s, border-color 0.3s;
}

.bento-argos:hover .argos-icon-wrap {
  background: rgba(41,112,163,0.14); border-color: rgba(41,112,163,0.26);
}

.argos-title {
  font-size: 1.75rem; font-weight: 300;
  letter-spacing: -0.02em; color: var(--okamed-deep); margin-bottom: 12px;
}

.argos-name { font-weight: 600; color: var(--okamed-accent); }

.argos-desc {
  font-size: 0.875rem; color: #475569;
  line-height: 1.65; flex: 1; margin-bottom: 28px;
}

.argos-cta {
  display: inline-flex; align-items: center; gap: 7px;
  font-size: 0.875rem; font-weight: 500; color: var(--okamed-accent);
  margin-top: auto; transition: gap 0.2s;
}

.bento-argos:hover .argos-cta { gap: 11px; }

.services-row {
  display: grid; grid-template-columns: repeat(4, 1fr);
  gap: 14px; margin-bottom: 20px;
}

.service-mini {
  display: flex; align-items: flex-start; gap: 14px;
  padding: 20px 22px; border-radius: 18px;
  background: rgba(255,255,255,0.58);
  backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255,255,255,0.80);
  box-shadow: 0 2px 12px rgba(11,46,78,0.05);
  transition: background 0.25s, box-shadow 0.25s, transform 0.25s, border-color 0.25s;
}

.service-mini:hover {
  background: rgba(255,255,255,0.88);
  box-shadow: 0 8px 28px rgba(11,46,78,0.10);
  transform: translateY(-3px);
  border-color: rgba(41,112,163,0.16);
}

.service-mini-icon {
  flex-shrink: 0; width: 36px; height: 36px; border-radius: 10px;
  background: rgba(41,112,163,0.07); border: 1px solid rgba(41,112,163,0.12);
  display: flex; align-items: center; justify-content: center;
  color: var(--okamed-accent); margin-top: 1px;
  transition: background 0.25s, border-color 0.25s;
}

.service-mini:hover .service-mini-icon {
  background: rgba(41,112,163,0.12); border-color: rgba(41,112,163,0.22);
}

.service-mini-label {
  font-size: 0.875rem; font-weight: 600;
  color: var(--okamed-deep); margin-bottom: 4px;
}

.service-mini-desc { font-size: 0.875rem; color: #475569; line-height: 1.55; }

/* CTA ver todos */
.all-services-cta {
  display: flex; justify-content: flex-end;
}

.all-services-link {
  display: inline-flex; align-items: center; gap: 7px;
  font-size: 0.875rem; font-weight: 500;
  color: var(--okamed-accent); text-decoration: none;
  opacity: 0.80;
  transition: opacity 0.2s, gap 0.2s;
}

.all-services-link:hover { opacity: 1; gap: 11px; }

@media (max-width: 900px) {
  .services-section { padding-top: 3rem; padding-bottom: 3rem; }
  .bento-grid { grid-template-columns: 1fr; }
  .bento-field { grid-column: span 1; min-height: 340px; padding: 36px 32px; }
  .bento-argos { grid-column: span 1; }
  .services-row { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 600px) {
  .services-row { grid-template-columns: 1fr; }
  .field-title { font-size: 2.2rem; }
}
</style>
