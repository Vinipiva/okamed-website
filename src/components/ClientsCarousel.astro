---
import client1 from "../assets/clients/client-1.png";
import client2 from "../assets/clients/client-2.png";
import client3 from "../assets/clients/client-3.png";
import client4 from "../assets/clients/client-4.png";
import client5 from "../assets/clients/client-5.png";
import client6 from "../assets/clients/client-6.png";
import client7 from "../assets/clients/client-7.png";
import client8 from "../assets/clients/client-8.png";

const logos = [client1, client2, client3, client4, client5, client6, client7, client8];
---

<div class="clients-wrapper">
  <div class="clients-label">Parceiros e clientes</div>
  <div class="clients-strip">
    <div class="carousel-track">
      <div class="carousel-set">
        {logos.map((logo, idx) => (
          <div class="client-card">
            <img src={logo.src} alt={`Cliente e parceiro Okamed ${idx + 1}`} />
          </div>
        ))}
      </div>
      <div class="carousel-set" aria-hidden="true">
        {logos.map((logo) => (
          <div class="client-card">
            <img src={logo.src} alt="" />
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
.clients-wrapper {
  width: 100%;
  background: rgba(244,246,248,0.80);
  backdrop-filter: blur(16px);
  border-top: 1px solid rgba(255,255,255,0.80);
  padding: 28px 0 32px;
}

.clients-label {
  text-align: center;
  font-size: 0.65rem;
  font-weight: 600;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: rgba(11,46,78,0.25);
  margin-bottom: 18px;
}

.clients-strip {
  overflow: hidden;
  mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
  -webkit-mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
}

.carousel-track {
  display: flex;
  gap: 40px;
  width: max-content;
  animation: scroll 28s linear infinite;
  will-change: transform;
}

.carousel-track:hover { animation-play-state: paused; }

.carousel-set {
  display: flex;
  align-items: center;
  gap: 40px;
}

.client-card {
  flex: 0 0 auto;
  width: 240px;
  height: 120px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18px;
  background: rgba(255,255,255,0.90);
  border: 1px solid rgba(255,255,255,0.95);
  box-shadow: 0 2px 12px rgba(11,46,78,0.07);
  padding: 16px 24px;
  transition: background 0.25s, box-shadow 0.25s, transform 0.25s;
}

.client-card:hover {
  background: rgba(255,255,255,1);
  box-shadow: 0 8px 24px rgba(11,46,78,0.12);
  transform: translateY(-2px);
}

.client-card img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  opacity: 0.85;
  transition: opacity 0.25s;
}

.client-card:hover img { opacity: 1; }

@keyframes scroll {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}
</style>
