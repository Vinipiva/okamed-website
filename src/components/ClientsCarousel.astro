  { src: `/clients/client_okamed-1.png`,  alt: `Hospital Emílio Carlos` },
  { src: `/clients/client_okamed-2.png`,  alt: `AME – Ambulatório Médico de Especialidades Catanduva` },
  { src: `/clients/client_okamed-3.png`,  alt: `Hospital de Clínicas São Bernardo do Campo` },
  { src: `/clients/client_okamed-4.png`,  alt: `Hospital da Mulher` },
  { src: `/clients/client_okamed-5.png`,  alt: `Hospital de Urgência São Bernardo do Campo` },
  { src: `/clients/client_okamed-6.png`,  alt: `O.S.S. Pirangi – Organização Social de Saúde Pirangi` },
  { src: `/clients/client_okamed-7.png`,  alt: `Hospital Anchieta` },
  { src: `/clients/client_okamed-8.png`,  alt: `IMC – Instituto de Moléstias Cardiovasculares` },
  { src: `/clients/client_okamed-9.png`,  alt: `Austa Hospital` },
  { src: `/clients/client_okamed-10.png`, alt: `Hospital Electro Bonini – UNAERP Ribeirão Preto` },
  { src: `/clients/client_okamed-11.png`, alt: `Hospital Beneficente Unimar` },
  { src: `/clients/client_okamed-12.png`, alt: `Santa Casa São Joaquim da Barra` },
  { src: `/clients/client_okamed-13.png`, alt: `Santa Casa de Misericórdia de Chavantes` },
  { src: `/clients/client_okamed-14.png`, alt: `Santa Casa de Misericórdia de São José do Rio Preto` },
  { src: `/clients/client_okamed-15.png`, alt: `Santa Casa Poços de Caldas` },
  { src: `/clients/client_okamed-16.png`, alt: `Hospital Regional Ilha Solteira` },
  { src: `/clients/client_okamed-17.png`, alt: `Hospital Estadual Porto Primavera` },
  { src: `/clients/client_okamed-18.png`, alt: `SAHISC – Serviço de Anestesiologia de São Carlos` },
  { src: `/clients/client_okamed-19.png`, alt: `Uniube – Universidade de Uberaba` },
  { src: `/clients/client_okamed-20.png`, alt: `Hospital Padre Colombo` },
  { src: `/clients/client_okamed-21.png`, alt: `Associação Lar São Francisco de Assis na Providência de Deus – VJDA` },
  { src: `/clients/client_okamed-22.png`, alt: `Hospital Estadual Mário Covas` },
  { src: `/clients/client_okamed-23.png`, alt: `Misericórdia Óbidos` },
  { src: `/clients/client_okamed-24.png`, alt: `OCRH – Centro de Reprodução Humana São José do Rio Preto` },
  { src: `/clients/client_okamed-25.png`, alt: `Prefeitura Municipal da Estância Turística de Olímpia/SP` },
  { src: `/clients/client_okamed-26.png`, alt: `Norden Hospital` },
  { src: `/clients/client_okamed-27.png`, alt: `Hospital Padre Tiago na Providência de Deus` },
  { src: `/clients/client_okamed-28.png`, alt: `Unimed Bebedouro` },
  { src: `/clients/client_okamed-29.png`, alt: `Unimed Marília` },
  { src: `/clients/client_okamed-30.png`, alt: `Unimed Catanduva` },
  { src: `/clients/client_okamed-31.png`, alt: `Unimed Araçatuba` },
  { src: `/clients/client_okamed-32.png`, alt: `Unimed São José do Rio Preto` },
  { src: `/clients/client_okamed-33.png`, alt: `Unimed Assis` },
  { src: `/clients/client_okamed.png`,    alt: `Hospital Padre Albino` },
];

const locale = Astro.currentLocale ?? (Astro.url.pathname.startsWith('/es/') ? 'es' : 'pt');
const isEs = locale === 'es';
const label = isEs ? 'Socios y clientes' : 'Parceiros e clientes';
---

<div class="clients-wrapper">
  <div class="clients-label">{label}</div>
  <div class="clients-strip">
    <div class="carousel-track">
      <div class="carousel-set" id="carousel-primary">
        {clientImages.map((img, idx) => (
          <div class="client-card">
            <img
              src={img.src}
              loading="lazy"
              decoding="async"
              alt={isEs
                ? `Logo de cliente o socio de Okamed número ${idx + 1}`
                : `Logo de cliente ou parceiro da Okamed número ${idx + 1}`}
            />
          </div>
        ))}
      </div>
      <div class="carousel-set" id="carousel-clone" aria-hidden="true"></div>
    </div>
  </div>
</div>

<script>
  const primary = document.getElementById("carousel-primary");
  const clone = document.getElementById("carousel-clone");

  if (primary && clone) {
    const cards = Array.from(primary.querySelectorAll<HTMLElement>(".client-card"));

    for (let i = cards.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [cards[i], cards[j]] = [cards[j], cards[i]];
    }

    primary.replaceChildren(...cards);

    cards.forEach((card) => {
      const cloned = card.cloneNode(true) as HTMLElement;
      const img = cloned.querySelector("img");
      if (img) img.alt = "";
      clone.appendChild(cloned);
    });
  }
</script>

<style>
.clients-wrapper {
  width: 100%;
  background: rgba(244,246,248,0.80);
  backdrop-filter: blur(16px);
  border-top: 1px solid rgba(255,255,255,0.80);
  padding: 28px 0 32px;
}

.clients-label {
  text-align: center;
  font-size: 0.875rem;
  font-weight: 600;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: rgba(11,46,78,0.45);
  margin-bottom: 18px;
}

.clients-strip {
  overflow: hidden;
  mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
  -webkit-mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
}

.carousel-track {
  display: flex;
  gap: 40px;
  width: max-content;
  animation: scroll 120s linear infinite;
  will-change: transform;
}

.carousel-track:hover { animation-play-state: paused; }

.carousel-set {
  display: flex;
  align-items: center;
  gap: 40px;
}

.client-card {
  flex: 0 0 auto;
  width: 200px;
  aspect-ratio: 512 / 400;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18px;
  background: rgba(255,255,255,0.90);
  border: 1px solid rgba(255,255,255,0.95);
  box-shadow: 0 2px 12px rgba(11,46,78,0.07);
  padding: 18px 20px;
  transition: background 0.25s, box-shadow 0.25s, transform 0.25s;
}

.client-card:hover {
  background: rgba(255,255,255,1);
  box-shadow: 0 8px 24px rgba(11,46,78,0.12);
  transform: translateY(-2px);
}

.client-card img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  opacity: 0.85;
  transition: opacity 0.25s;
}

.client-card:hover img { opacity: 1; }

@keyframes scroll {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}
</style>
