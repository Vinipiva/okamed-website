---
import HeroVideo from "./HeroVideo.astro";
import ClientsCarousel from "./ClientsCarousel.astro";
import LangSwitcher from "./LangSwitcher.astro";
import { useTranslations } from "../i18n/utils";

const t = useTranslations(Astro.currentLocale ?? (Astro.url.pathname.startsWith('/es/') ? 'es' : 'pt'));
---

<section class="hero-section relative overflow-hidden">

  <HeroVideo />

  <!-- NAVBAR -->
  <header class="fixed top-0 left-0 w-full z-50 glass-nav">
    <div class="max-w-7xl mx-auto px-6 py-5 flex items-center justify-between">

      <img src="/assets/logo_okamed.svg" alt="Okamed" class="h-7" width="120" height="28" fetchpriority="high" />

      <nav class="hidden md:flex items-center gap-8 text-sm" aria-label="Navegação principal">
        <a href="#servicos" class="nav-link">{t.nav.services}</a>
        <a href="#argos" class="nav-link">{t.nav.argos}</a>
        <a href="#contato" class="nav-link">{t.nav.contact}</a>
        <LangSwitcher />
        <a href="#contato" class="btn-primary text-sm py-2.5 px-5">{t.nav.cta}</a>
      </nav>

      <div class="md:hidden flex items-center gap-4">
        <LangSwitcher />
        <button
          id="mobile-menu-btn"
          class="text-[#0B2E4E]/70 hover:text-[#0B2E4E] transition p-1"
          aria-label="Abrir menu de navegação"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
            <path d="M3 6h16M3 11h16M3 16h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </button>
      </div>

    </div>
  </header>

  <!-- AMBIENT GLOWS -->
  <div class="absolute inset-0 z-5 pointer-events-none" aria-hidden="true">
    <div class="absolute top-1/4 left-1/3 w-[600px] h-[500px] bg-[#6EB6FF] rounded-full opacity-[0.10] blur-[130px]"></div>
    <div class="absolute top-1/3 right-1/4 w-[400px] h-[400px] bg-[#8FDFFF] rounded-full opacity-[0.07] blur-[100px]"></div>
  </div>

  <!-- CONTENT -->
  <div class="relative z-20 max-w-7xl mx-auto px-6 flex items-start md:items-center pt-24 pb-24 md:pt-28 md:pb-28 min-h-[72vh] md:min-h-[80vh]">
    <div class="max-w-2xl w-full bg-white/80 border border-white/70 backdrop-blur-3xl rounded-[32px] p-6 shadow-[0_24px_80px_rgba(11,46,78,0.10)] md:bg-transparent md:border-none md:backdrop-blur-none md:shadow-none md:p-0 md:max-w-2xl lg:max-w-3xl">

      <div class="section-label mb-6 animate-hero-1">
        {t.hero.tag}
      </div>

      <h1 class="hero-title animate-hero-2">
        {t.hero.title.split('\n').map((line, i) => (
          <>
            {i > 0 && <br/>}
            {line}
          </>
        ))}
      </h1>

      <p class="mt-7 text-base md:text-lg text-slate-500 max-w-md leading-relaxed animate-hero-3">
        {t.hero.description}
      </p>

      <div class="mt-10 flex flex-wrap gap-4 animate-hero-4">
        <a href="#contato" class="btn-primary">
          {t.hero.ctaPrimary}
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="#servicos" class="btn-outline">
          {t.hero.ctaSecondary}
        </a>
      </div>

    </div>
  </div>

  <!-- CLIENTS STRIP -->
  <div class="absolute bottom-0 left-0 w-full z-20">
    <ClientsCarousel />
  </div>

</section>


<style>

.hero-title {
  font-weight: 300;
  font-size: clamp(64px, 10vw, 118px);
  line-height: 0.92;
  letter-spacing: -0.04em;
  background: linear-gradient(180deg, #0B2E4E 0%, #1E537E 45%, #0B2E4E 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.nav-link {
  color: #0B2E4E;
  opacity: 0.6;
  transition: opacity 0.2s;
}
.nav-link:hover {
  opacity: 1;
}

.animate-hero-1 { animation: floatUp 0.8s 0.2s cubic-bezier(0.22,1,0.36,1) both; }
.animate-hero-2 { animation: floatUp 0.9s 0.35s cubic-bezier(0.22,1,0.36,1) both; }
.animate-hero-3 { animation: floatUp 0.9s 0.5s cubic-bezier(0.22,1,0.36,1) both; }
.animate-hero-4 { animation: floatUp 0.9s 0.65s cubic-bezier(0.22,1,0.36,1) both; }

@keyframes floatUp {
  from { opacity: 0; transform: translateY(28px); }
  to   { opacity: 1; transform: translateY(0); }
}

</style>
