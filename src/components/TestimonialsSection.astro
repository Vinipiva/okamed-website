---
import { useTranslations } from "../i18n/utils";
const t = useTranslations(Astro.currentLocale ?? (Astro.url.pathname.startsWith('/es/') ? 'es' : 'pt'));

const testimonials = [
  {
    quote_pt: "A Okamed transformou completamente nossa gestão de equipamentos médicos. Reduzimos custos em 35% e aumentamos a conformidade regulatória.",
    quote_es: "Okamed transformó completamente nuestra gestión de equipos médicos. Reducimos costos en un 35% y aumentamos el cumplimiento normativo.",
    author: "Dr. Carlos Silva",
    role_pt: "Diretor de Operações",
    role_es: "Director de Operaciones",
    institution: "Hospital São Lucas",
    rating: 5
  },
  {
    quote_pt: "A plataforma Argos é intuitiva e potente. Nossos engenheiros clínicos agora gastam 50% menos tempo em rastreamento de dados.",
    quote_es: "La plataforma Argos es intuitiva y potente. Nuestros ingenieros clínicos ahora pasan un 50% menos de tiempo en el seguimiento de datos.",
    author: "Fernanda Costa",
    role_pt: "Engenheira Clínica",
    role_es: "Ingeniera Clínica",
    institution: "Rede de Clínicas Metropolitana",
    rating: 5
  },
  {
    quote_pt: "Implementação rápida, suporte exemplar. A Okamed realmente entende os desafios da saúde no Brasil.",
    quote_es: "Implementación rápida, soporte ejemplar. Okamed realmente comprende los desafíos de la salud en Brasil.",
    author: "Marcelo Ribeiro",
    role_pt: "Gerente de TI",
    role_es: "Gerente de TI",
    institution: "Hospital Universitário Federal",
    rating: 5
  }
];
---

<section class="relative py-28 px-6 bg-gradient-to-b from-white via-slate-50 to-white">
  <div class="max-w-7xl mx-auto">

    <!-- Header -->
    <div class="mb-16 reveal text-center">
      <p class="section-label mb-4">{t.locale === 'es' ? 'Casos de Éxito' : 'Casos de Sucesso'}</p>
      <h2 class="section-title max-w-2xl mx-auto">
        {t.locale === 'es' 
          ? 'Lo que nuestros clientes dicen'
          : 'O que nossos clientes dizem'}
      </h2>
      <p class="text-slate-500 mt-6 max-w-2xl mx-auto leading-relaxed">
        {t.locale === 'es' 
          ? 'Instituciones de salud en toda Latinoamérica confían en Okamed para optimizar sus operaciones.'
          : 'Instituições de saúde em toda a América Latina confiam na Okamed para otimizar suas operações.'}
      </p>
    </div>

    <!-- Testimonials Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {testimonials.map((testimonial, idx) => (
        <div class="testimonial-card reveal" style={`--delay: ${idx + 1}`}>
          
          <!-- Stars -->
          <div class="flex gap-1 mb-6">
            {[...Array(testimonial.rating)].map(() => (
              <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" class="text-amber-400">
                <path d="M8 1.5L10.4 7h5.8l-4.6 3.8L12.4 16 8 12.2 3.6 16l1.8-5.2L.8 7h5.8L8 1.5Z"/>
              </svg>
            ))}
          </div>

          <!-- Quote -->
          <blockquote class="testimonial-quote">
            "{t.locale === 'es' ? testimonial.quote_es : testimonial.quote_pt}"
          </blockquote>

          <!-- Author -->
          <div class="mt-6 pt-6 border-t border-slate-100">
            <p class="testimonial-author">{testimonial.author}</p>
            <p class="testimonial-role">{t.locale === 'es' ? testimonial.role_es : testimonial.role_pt}</p>
            <p class="testimonial-institution">{testimonial.institution}</p>
          </div>

        </div>
      ))}
    </div>

    <!-- Stats -->
    <div class="mt-20 pt-12 border-t border-slate-200 grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
      
      <div class="reveal delay-4">
        <p class="stat-value text-[#2970A3]">500+</p>
        <p class="stat-label text-slate-600">
          {t.locale === 'es' ? 'Instituciones' : 'Instituições'}
        </p>
      </div>

      <div class="reveal delay-5">
        <p class="stat-value text-[#2970A3]">99.9%</p>
        <p class="stat-label text-slate-600">
          {t.locale === 'es' ? 'Disponibilidad' : 'Disponibilidade'}
        </p>
      </div>

      <div class="reveal delay-6">
        <p class="stat-value text-[#2970A3]">35%</p>
        <p class="stat-label text-slate-600">
          {t.locale === 'es' ? 'Reducción de costos' : 'Redução de custos'}
        </p>
      </div>

      <div class="reveal delay-7">
        <p class="stat-value text-[#2970A3]">4.9/5</p>
        <p class="stat-label text-slate-600">
          {t.locale === 'es' ? 'Calificación' : 'Avaliação'}
        </p>
      </div>

    </div>

  </div>
</section>

<style>
.testimonial-card {
  padding: 32px 28px;
  border: 1px solid rgba(11, 46, 78, 0.08);
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(14px);
  display: flex;
  flex-direction: column;
  transition: all 0.3s ease;
  animation: floatUp 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
  animation-delay: calc(var(--delay, 0) * 0.1s);
}

.testimonial-card:hover {
  border-color: rgba(41, 112, 163, 0.25);
  background: rgba(255, 255, 255, 1);
  box-shadow: 0 16px 40px rgba(11, 46, 78, 0.10);
  transform: translateY(-6px);
}

.testimonial-quote {
  font-size: 1rem;
  line-height: 1.6;
  color: #1e293b;
  font-weight: 500;
}

.testimonial-author {
  font-weight: 600;
  color: #0B2E4E;
  font-size: 0.95rem;
}

.testimonial-role {
  font-size: 0.875rem;
  color: #2970A3;
  margin-top: 2px;
}

.testimonial-institution {
  font-size: 0.8rem;
  color: #94a3b8;
  margin-top: 4px;
}

.stat-value {
  font-size: 2rem;
  font-weight: 700;
  display: block;
}

.stat-label {
  font-size: 0.875rem;
  margin-top: 4px;
}

@keyframes floatUp {
  from {
    opacity: 0;
    transform: translateY(28px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
</style>
