---
const currentLocale = Astro.currentLocale ?? (Astro.url.pathname.startsWith('/es/') ? 'es' : 'pt');
const ptHref = '/';
const esHref = '/es/';
---

<div class="lang-switcher" role="navigation" aria-label="Seleção de idioma">
  <a
    href={ptHref}
    class:list={['lang-btn', { 'lang-btn--active': currentLocale === 'pt' }]}
    aria-current={currentLocale === 'pt' ? 'page' : undefined}
    hreflang="pt"
  >
    PT
  </a>
  <span class="lang-divider" aria-hidden="true">|</span>
  <a
    href={esHref}
    class:list={['lang-btn', { 'lang-btn--active': currentLocale === 'es' }]}
    aria-current={currentLocale === 'es' ? 'page' : undefined}
    hreflang="es"
  >
    ES
  </a>
</div>

<style>
.lang-switcher {
  display: flex;
  align-items: center;
  gap: 6px;
}

.lang-btn {
  font-size: 0.875rem;
  font-weight: 500;
  letter-spacing: 0.06em;
  color: #0B2E4E;
  opacity: 0.5;
  transition: opacity 0.2s;
  text-decoration: none;
  padding: 2px 0;
}

.lang-btn:hover,
.lang-btn--active {
  opacity: 1;
}

.lang-btn--active {
  font-weight: 600;
}

.lang-divider {
  font-size: 0.875rem;
  color: #0B2E4E;
  opacity: 0.2;
  user-select: none;
}
</style>
