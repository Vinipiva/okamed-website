---
import { useTranslations } from "../i18n/utils";
const t = useTranslations(Astro.currentLocale ?? (Astro.url.pathname.startsWith('/es/') ? 'es' : 'pt'));
---

<section class="relative py-28 px-6 bg-white">
  <div class="max-w-7xl mx-auto">

    <!-- Header -->
    <div class="mb-16 reveal text-center">
      <p class="section-label mb-4">{t.locale === 'es' ? 'Confianza y Calidad' : 'Confiança e Qualidade'}</p>
      <h2 class="section-title max-w-2xl mx-auto">
        {t.locale === 'es' ? 'Certificaciones y Acreditaciones' : 'Certificações e Acreditações'}
      </h2>
      <p class="text-slate-500 mt-6 max-w-2xl mx-auto leading-relaxed">
        {t.locale === 'es' 
          ? 'Respaldados por reconocimientos internacionales que garantizan calidad, seguridad y cumplimiento normativo en nuestras soluciones.'
          : 'Respaldados por reconhecimentos internacionais que garantem qualidade, segurança e conformidade regulatória em nossas soluções.'}
      </p>
    </div>

    <!-- Grid de Certificações -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      
      <!-- ISO 13485 -->
      <div class="cert-card reveal delay-1">
        <div class="cert-icon">
          <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
            <rect x="8" y="8" width="32" height="32" rx="4" stroke="currentColor" stroke-width="2"/>
            <path d="M18 24L21 27l8-8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h3 class="cert-title">ISO 13485</h3>
        <p class="cert-desc">
          {t.locale === 'es' 
            ? 'Gestión de calidad en dispositivos médicos'
            : 'Gestão de qualidade em dispositivos médicos'}
        </p>
      </div>

      <!-- ISO 9001 -->
      <div class="cert-card reveal delay-2">
        <div class="cert-icon">
          <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
            <circle cx="24" cy="24" r="16" stroke="currentColor" stroke-width="2"/>
            <path d="M20 24l2 2 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h3 class="cert-title">ISO 9001</h3>
        <p class="cert-desc">
          {t.locale === 'es' 
            ? 'Sistema de gestión de calidad'
            : 'Sistema de gestão da qualidade'}
        </p>
      </div>

      <!-- ANVISA -->
      <div class="cert-card reveal delay-3">
        <div class="cert-icon">
          <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
            <path d="M24 8v32M8 24h32" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            <circle cx="24" cy="24" r="16" stroke="currentColor" stroke-width="2"/>
          </svg>
        </div>
        <h3 class="cert-title">ANVISA</h3>
        <p class="cert-desc">
          {t.locale === 'es' 
            ? 'Registro y autorización en Brasil'
            : 'Registro e autorização no Brasil'}
        </p>
      </div>

      <!-- Segurança de Dados -->
      <div class="cert-card reveal delay-4">
        <div class="cert-icon">
          <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
            <path d="M24 8L10 14v10c0 10 14 14 14 14s14-4 14-14v-10L24 8Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
            <path d="M20 24l2 2 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h3 class="cert-title">{t.locale === 'es' ? 'Seguridad' : 'Segurança'}</h3>
        <p class="cert-desc">
          {t.locale === 'es' 
            ? 'Encriptación y protección de datos LGPD'
            : 'Criptografia e proteção de dados LGPD'}
        </p>
      </div>

    </div>

    <!-- Info adicional -->
    <div class="mt-16 pt-12 border-t border-slate-100 grid md:grid-cols-3 gap-8">
      
      <div class="reveal delay-5 text-center">
        <div class="text-3xl font-semibold text-[#2970A3] mb-2">15+</div>
        <p class="text-slate-600 text-sm">
          {t.locale === 'es' 
            ? 'Años de experiencia en ingeniería clínica'
            : 'Anos de experiência em engenharia clínica'}
        </p>
      </div>

      <div class="reveal delay-6 text-center">
        <div class="text-3xl font-semibold text-[#2970A3] mb-2">500+</div>
        <p class="text-slate-600 text-sm">
          {t.locale === 'es' 
            ? 'Instituciones de salud confían en nuestras soluciones'
            : 'Instituições de saúde confiam em nossas soluções'}
        </p>
      </div>

      <div class="reveal delay-7 text-center">
        <div class="text-3xl font-semibold text-[#2970A3] mb-2">24/7</div>
        <p class="text-slate-600 text-sm">
          {t.locale === 'es' 
            ? 'Soporte técnico y atención al cliente'
            : 'Suporte técnico e atendimento ao cliente'}
        </p>
      </div>

    </div>

  </div>
</section>

<style>
.cert-card {
  padding: 28px 24px;
  border: 1px solid rgba(11, 46, 78, 0.07);
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(14px);
  text-align: center;
  transition: all 0.3s ease;
}

.cert-card:hover {
  border-color: rgba(41, 112, 163, 0.20);
  background: rgba(255, 255, 255, 1);
  box-shadow: 0 12px 32px rgba(11, 46, 78, 0.08);
  transform: translateY(-4px);
}

.cert-icon {
  width: 64px;
  height: 64px;
  margin: 0 auto 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14px;
  background: linear-gradient(135deg, rgba(41, 112, 163, 0.10), rgba(30, 83, 126, 0.05));
  color: #2970A3;
  transition: all 0.3s ease;
}

.cert-card:hover .cert-icon {
  background: linear-gradient(135deg, rgba(41, 112, 163, 0.15), rgba(30, 83, 126, 0.10));
}

.cert-title {
  font-size: 1.125rem;
  font-weight: 600;
  color: #0B2E4E;
  margin-bottom: 8px;
}

.cert-desc {
  font-size: 0.875rem;
  color: #64748b;
  line-height: 1.4;
}
</style>
