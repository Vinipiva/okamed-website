---
import { useTranslations } from "../i18n/utils";
const t = useTranslations(Astro.currentLocale ?? (Astro.url.pathname.startsWith('/es/') ? 'es' : 'pt'));
---

<footer class="relative border-t border-slate-100 bg-white">
  <div class="max-w-7xl mx-auto px-6 py-16">

    <div class="grid gap-12 md:grid-cols-3 mb-16">

      <div>
        <img src="/assets/logo_okamed.svg" alt="Okamed" class="h-7 mb-5" />
        <p class="text-sm text-slate-500 max-w-xs leading-relaxed">
          {t.footer.description}
        </p>
      </div>

      <div>
        <p class="text-sm font-semibold text-slate-500 uppercase tracking-[0.15em] mb-5">{t.footer.navTitle}</p>
        <ul class="space-y-3 text-sm">
          <li><a href="#servicos" class="text-slate-500 hover:text-[#0B2E4E] transition-colors">{t.footer.links.services}</a></li>
          <li><a href="#argos"    class="text-slate-500 hover:text-[#0B2E4E] transition-colors">{t.footer.links.argos}</a></li>
          <li><a href="#contato"  class="text-slate-500 hover:text-[#0B2E4E] transition-colors">{t.footer.links.contact}</a></li>
        </ul>
      </div>

      <div>
        <p class="text-sm font-semibold text-slate-500 uppercase tracking-[0.15em] mb-5">{t.footer.contactTitle}</p>
        <ul class="space-y-3 text-sm">
          <li><a href="mailto:comercial@okamed.com.br" class="text-slate-500 hover:text-[#0B2E4E] transition-colors">comercial@okamed.com.br</a></li>
          <li><a href="https://wa.me/5517992842335"    class="text-slate-500 hover:text-[#0B2E4E] transition-colors">+55 (17) 99284-2335</a></li>
          <li class="text-slate-400">São José do Rio Preto – SP</li>
        </ul>
      </div>

    </div>

    <div class="flex flex-col md:flex-row items-center justify-between gap-4 border-t border-slate-100 pt-8 text-sm text-slate-400">
      <div class="flex gap-6">
        <p>© {new Date().getFullYear()} Okamed. {t.footer.copyright}</p>
        <a href={Astro.currentLocale === 'es' ? '/es/politica-privacidade' : '/politica-privacidade'} class="hover:text-[#0B2E4E] transition-colors">{t.locale === 'es' ? 'Política de Privacidad' : 'Política de Privacidade'}</a>
      </div>
      <p>{t.footer.builtWith}</p>
    </div>

  </div>
</footer>
