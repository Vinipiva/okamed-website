---
import { useTranslations } from "../i18n/utils";
const t = useTranslations(Astro.currentLocale ?? (Astro.url.pathname.startsWith('/es/') ? 'es' : 'pt'));

const contactIcons = [
  `<svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M14.5 12.5c-.7-.7-1.5-.7-2.2 0l-.9.9c-.2.2-.4.2-.6.1-1.2-.7-2.3-1.6-3.3-2.6S5.7 9.2 5 8c-.1-.2-.1-.4.1-.6l.9-.9c.7-.7.7-1.5 0-2.2L4.7 3c-.7-.7-1.5-.7-2.2 0L1.6 3.9C.6 4.9.5 6.2 1 7.4c1.2 3 3.4 5.7 6.1 7.8 2.3 1.8 5 2.8 7.5 2.8.8 0 1.5-.3 2-.8l.9-.9c.7-.7.7-1.5 0-2.2l-2-1.6z" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>`,
  `<svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M2.5 5.5h15v9a1 1 0 0 1-1 1h-13a1 1 0 0 1-1-1v-9z" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/><path d="M2.5 5.5 10 11l7.5-5.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  `<svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M10 2a6 6 0 0 0-6 6c0 4 6 10 6 10s6-6 6-10a6 6 0 0 0-6-6z" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/><circle cx="10" cy="8" r="2" stroke="currentColor" stroke-width="1.4"/></svg>`,
];
---

<section id="contato" class="relative py-28 px-6 bg-white overflow-hidden">

  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-slate-200 to-transparent"></div>
    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[700px] h-[300px] bg-[#6EB6FF] rounded-full opacity-[0.06] blur-[100px]"></div>
  </div>

  <div class="max-w-5xl mx-auto">
    <div class="contact-card reveal">

      <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[rgba(41,112,163,0.30)] to-transparent rounded-t-[28px]"></div>

      <div class="grid lg:grid-cols-2 gap-12 items-start">

        <div>
          <p class="section-label mb-4">{t.contact.label}</p>
          <h2 class="text-[#0B2E4E] font-light text-4xl md:text-5xl leading-tight tracking-tight mb-5">
            {t.contact.title.split('\n').map((line: string, i: number) => (
              <>
                {i > 0 && <br/>}
                {line}
              </>
            ))}
          </h2>
          <p class="text-slate-500 text-base leading-relaxed max-w-sm">
            {t.contact.description}
          </p>

          <div class="mt-8 flex flex-wrap gap-3">
            <a href="https://wa.me/5517992842335" target="_blank" rel="noopener" class="btn-primary">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M13.5 2.5A7.5 7.5 0 0 0 1 8.25c0 1.3.35 2.55.95 3.65L1 15l3.2-.9A7.5 7.5 0 1 0 13.5 2.5z" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {t.contact.cta}
            </a>
          </div>
        </div>

        <div class="space-y-3">
          {t.contact.contacts.map((c: { label: string; value: string; href: string | null }, i: number) => (
            <div class="contact-row">
              <div class="contact-icon">
                <Fragment set:html={contactIcons[i]} />
              </div>
              <div>
                <p class="text-slate-400 text-xs mb-1">{c.label}</p>
                {c.href ? (
                  <a href={c.href} target="_blank" rel="noopener" class="text-[#0B2E4E]/85 text-sm font-medium hover:text-[var(--okamed-accent)] transition-colors">
                    {c.value}
                  </a>
                ) : (
                  <p class="text-[#0B2E4E]/85 text-sm font-medium whitespace-pre-line">{c.value}</p>
                )}
              </div>
            </div>
          ))}
        </div>

      </div>
    </div>
  </div>
</section>

<style>
.contact-card {
  background: rgba(255,255,255,0.72);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1px solid rgba(255,255,255,0.92);
  border-radius: 28px;
  padding: 60px 56px;
  position: relative;
  overflow: hidden;
  box-shadow: 0 8px 40px rgba(11,46,78,0.08), inset 0 1px 0 rgba(255,255,255,0.95);
}

.contact-row {
  display: flex;
  align-items: flex-start;
  gap: 13px;
  padding: 15px 17px;
  background: rgba(244,246,248,0.60);
  border: 1px solid rgba(255,255,255,0.90);
  border-radius: 14px;
  transition: background 0.25s, border-color 0.25s, box-shadow 0.25s, transform 0.25s;
}

.contact-row:hover {
  background: rgba(255,255,255,0.90);
  border-color: rgba(41,112,163,0.15);
  box-shadow: 0 6px 24px rgba(11,46,78,0.08);
  transform: translateX(4px);
}

.contact-icon {
  flex-shrink: 0;
  width: 38px;
  height: 38px;
  border-radius: 10px;
  background: rgba(41,112,163,0.07);
  border: 1px solid rgba(41,112,163,0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--okamed-accent);
}

@media (max-width: 768px) {
  .contact-card { padding: 36px 28px; }
}
</style>
